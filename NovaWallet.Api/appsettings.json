{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=db;Port=5432;Database=novawallet;Username=novawallet;Password=novawallet_dev_password"
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-please-32chars-min",
    "Issuer": "novawallet-dev-issuer",
    "Audience": "novawallet-api",
    "ExpiryMinutes": 60
  },
  "TransferLimits": {
    "DailyOutboundLimitKobo": 50000000
  },
  "RateLimit": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "Outbox": {
    "PollIntervalSeconds": 5
  },
  "OutboxRetry": {
    "MaxAttempts": 10,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 300
  }
}
